diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 53f1eb8c..2bd4b437 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -7,6 +7,7 @@ plugins {
     alias(libs.plugins.kotlin.parcelize)
     alias(libs.plugins.kotlin.serialization)
     alias(libs.plugins.ksp)
+    alias(libs.plugins.kotlin.compose) // BumBoard
 }
 
 android {
@@ -140,3 +141,62 @@ configurations {
         exclude(group = "com.louiscad.splitties", module = "splitties-systemservices")
     }
 }
+
+// ---------------------------------------------------------------- BumBoard
+// BumBoard's own code, resources and data live outside upstream (bumboard/app, bumboard/data)
+// and are added to the debug and release source sets, so their resources can override
+// upstream ones by name without touching upstream files.
+val bumboardDir = rootDir.resolve("../..")
+
+android {
+    // Compose (BOM 2026.09) needs compileSdk 37; targetSdk stays at upstream's value
+    compileSdk = 37
+    defaultConfig {
+        applicationId = "app.bumboard.android"
+        // Material 3 Compose 1.5 needs Android 7.0+
+        minSdk = 24
+        @Suppress("UnstableApiUsage")
+        externalNativeBuild {
+            cmake {
+                // Rime is built into the app instead of shipping as a plugin APK
+                targets("rime")
+            }
+        }
+    }
+    buildTypes {
+        release {
+            resValue("mipmap", "app_icon", "@mipmap/bumboard_icon")
+            resValue("mipmap", "app_icon_round", "@mipmap/bumboard_icon")
+            resValue("string", "app_name", "BumBoard")
+        }
+        debug {
+            resValue("mipmap", "app_icon", "@mipmap/bumboard_icon")
+            resValue("mipmap", "app_icon_round", "@mipmap/bumboard_icon")
+            resValue("string", "app_name", "BumBoard Debug")
+        }
+    }
+    buildFeatures {
+        compose = true
+    }
+    sourceSets.matching { it.name == "debug" || it.name == "release" }.configureEach {
+        kotlin.srcDir(bumboardDir.resolve("app/kotlin"))
+        res.srcDir(bumboardDir.resolve("app/res"))
+        assets.srcDir(bumboardDir.resolve("data/out/assets"))
+        manifest.srcFile(bumboardDir.resolve("app/AndroidManifest.xml"))
+    }
+}
+
+generateDataDescriptor {
+    // Rime finds OpenCC's tables through rime-data/opencc, as in the Rime plugin
+    symlinks.put("usr/share/rime-data/opencc", "usr/share/opencc")
+}
+
+dependencies {
+    implementation(project(":bumboard-core"))
+    // Material 3 Expressive settings (versions as validated by the Quartz project in this repo)
+    implementation(platform("androidx.compose:compose-bom:2026.09.00"))
+    implementation("androidx.compose.material3:material3:1.5.0-beta01")
+    implementation("androidx.compose.ui:ui")
+    implementation("androidx.compose.foundation:foundation")
+    implementation("androidx.activity:activity-compose:1.13.0")
+}
