<?xml version="1.0" encoding="utf-8"?>
<!-- BumBoard: replaces upstream's res/xml/input_method.xml (settings open BumBoard's settings). -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configChanges="uiMode"
    android:settingsActivity="app.bumboard.settings.SettingsActivity"
    android:supportsInlineSuggestions="true"
    android:supportsSwitchingToNextInputMethod="true"
    tools:targetApi="30">
    <subtype
        android:icon="@mipmap/bumboard_icon"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/app_name"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
