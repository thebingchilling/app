+		t.Fatalf("packet length %d, want a 64-byte HMAC-SHA512 tag", len(packet))
+	}
+	if _, _, _, plaintext, err := server.Unwrap(packet); err != nil || string(plaintext) != "hello" {
+		t.Fatalf("unwrap = %q, %v", plaintext, err)
+	}
+	sha1Server, _ := NewTLSAuth(testStaticKey(), "0")
+	if _, _, _, _, err := sha1Server.Unwrap(packet); err == nil {
+		t.Fatal("an HMAC-SHA1 peer accepted an HMAC-SHA512 packet")
+	}
+}
