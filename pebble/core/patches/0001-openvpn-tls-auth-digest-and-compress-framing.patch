diff --git a/transport/openvpn/compress.go b/transport/openvpn/compress.go
new file mode 100644
index 00000000..52a802f2
--- /dev/null
+++ b/transport/openvpn/compress.go
@@ -0,0 +1,148 @@
+package openvpn
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/pierrec/lz4/v4"
+)
+
+// Compression framing of data channel packets, as in OpenVPN's comp.h.
+// The client never compresses; it frames outgoing packets the way the
+// server expects and decompresses what the server sends.
+type compressFraming int32
+
+const (
+	framingNone compressFraming = iota
+	// comp-lzo (any mode) and "compress lzo": one header byte in front.
+	framingLZO
+	// "compress", "compress stub" and "compress lz4": the header byte
+	// replaces the first byte, which moves to the end of the packet.
+	framingSwap
+	// "compress stub-v2" and "compress lz4-v2": packets go as they are
+	// unless they start with the 0x50 indicator byte.
+	framingV2
+)
+
+const (
+	CompressStub   = "stub"
+	CompressLZ4    = "lz4"
+	CompressLZO    = "lzo"
+	CompressStubV2 = "stub-v2"
+	CompressLZ4V2  = "lz4-v2"
+
+	noCompressByteSwap  = 0xFB
+	lz4CompressByte     = 0x69
+	compV2Indicator     = 0x50
+	compV2Uncompressed  = 0
+	compV2LZ4           = 1
+	maxDecompressedSize = 1 << 16
+)
+
+var errCompressedPacket = errors.New("openvpn: unsupported compressed packet")
+
+// normalizeCompress maps the "compress" argument; "compress" without one
+// means the stub.
+func normalizeCompress(compress string) string {
+	switch value := strings.ToLower(strings.TrimSpace(compress)); value {
+	case "", "no", "none", "false", "migrate":
+		return ""
+	case "yes", "true", "stub":
+		return CompressStub
+	default:
+		return value
+	}
+}
+
+func framingFor(compLZO, compress string) compressFraming {
+	switch normalizeCompress(compress) {
+	case CompressStub, CompressLZ4:
+		return framingSwap
+	case CompressStubV2, CompressLZ4V2:
+		return framingV2
+	case CompressLZO:
+		return framingLZO
+	}
+	if strings.TrimSpace(compLZO) != "" {
+		return framingLZO
+	}
+	return framingNone
+}
+
+func frameOutgoing(framing compressFraming, packet []byte) []byte {
+	switch framing {
+	case framingLZO:
+		out := make([]byte, len(packet)+1)
+		out[0] = lzoCompressNone
+		copy(out[1:], packet)
+		return out
+	case framingSwap:
+		if len(packet) == 0 {
+			return []byte{noCompressByteSwap}
+		}
+		out := make([]byte, len(packet)+1)
+		out[0] = noCompressByteSwap
+		copy(out[1:], packet[1:])
+		out[len(packet)] = packet[0]
+		return out
+	case framingV2:
+		if len(packet) > 0 && packet[0] == compV2Indicator {
+			out := make([]byte, len(packet)+2)
+			out[0] = compV2Indicator
+			out[1] = compV2Uncompressed
+			copy(out[2:], packet)
+			return out
+		}
+	}
+	return packet
+}
+
+func unframeIncoming(framing compressFraming, packet []byte) ([]byte, error) {
+	if len(packet) == 0 {
+		return packet, nil
+	}
+	switch framing {
+	case framingLZO:
+		return lzo1xDecompressSafe(packet)
+	case framingSwap:
+		switch packet[0] {
+		case noCompressByteSwap, lz4CompressByte:
+			body := make([]byte, len(packet)-1)
+			if len(body) > 0 {
+				body[0] = packet[len(packet)-1]
+				copy(body[1:], packet[1:len(packet)-1])
+			}
+			if packet[0] == lz4CompressByte {
+				return lz4Decompress(body)
+			}
+			return body, nil
+		case lzoCompressNone, lzoCompressLZO:
+			return lzo1xDecompressSafe(packet)
+		}
+		return nil, errCompressedPacket
+	case framingV2:
+		if packet[0] != compV2Indicator {
+			return packet, nil
+		}
+		if len(packet) < 2 {
+			return nil, errCompressedPacket
+		}
+		switch packet[1] {
+		case compV2Uncompressed:
+			return packet[2:], nil
+		case compV2LZ4:
+			return lz4Decompress(packet[2:])
+		}
+		return nil, errCompressedPacket
+	}
+	return packet, nil
+}
+
+func lz4Decompress(src []byte) ([]byte, error) {
+	dst := make([]byte, maxDecompressedSize)
+	n, err := lz4.UncompressBlock(src, dst)
+	if err != nil {
+		return nil, err
+	}
+	return dst[:n], nil
+}
diff --git a/transport/openvpn/compress_test.go b/transport/openvpn/compress_test.go
new file mode 100644
index 00000000..fd93a5d9
--- /dev/null
+++ b/transport/openvpn/compress_test.go
@@ -0,0 +1,90 @@
+package openvpn
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/pierrec/lz4/v4"
+)
+
+func TestFramingFollowsTheConfig(t *testing.T) {
+	cases := []struct {
+		compLZO, compress string
+		want              compressFraming
+	}{
+		{"", "", framingNone},
+		{"no", "", framingLZO},
+		{"yes", "", framingLZO},
+		{"", "stub", framingSwap},
+		{"", "yes", framingSwap},
+		{"", "lz4", framingSwap},
+		{"", "lzo", framingLZO},
+		{"", "stub-v2", framingV2},
+		{"", "lz4-v2", framingV2},
+		{"", "migrate", framingNone},
+	}
+	for _, c := range cases {
+		if got := framingFor(c.compLZO, c.compress); got != c.want {
+			t.Errorf("framingFor(%q, %q) = %d, want %d", c.compLZO, c.compress, got, c.want)
+		}
+	}
+}
+
+func TestFramingRoundTrips(t *testing.T) {
+	packets := [][]byte{{0x45, 1, 2, 3}, {compV2Indicator, 9, 9}, {0x60}}
+	for _, framing := range []compressFraming{framingNone, framingLZO, framingSwap, framingV2} {
+		for _, packet := range packets {
+			framed := frameOutgoing(framing, append([]byte(nil), packet...))
+			got, err := unframeIncoming(framing, framed)
+			if err != nil || !bytes.Equal(got, packet) {
+				t.Errorf("framing %d: %x -> %x -> %x, %v", framing, packet, framed, got, err)
+			}
+		}
+	}
+	if got := frameOutgoing(framingSwap, []byte{0x45, 1, 2}); !bytes.Equal(got, []byte{noCompressByteSwap, 1, 2, 0x45}) {
+		t.Errorf("swap framing = %x", got)
+	}
+	if got := frameOutgoing(framingV2, []byte{0x45, 1}); !bytes.Equal(got, []byte{0x45, 1}) {
+		t.Errorf("v2 framing changed a plain packet: %x", got)
+	}
+}
+
+func TestLZ4PacketsAreDecompressed(t *testing.T) {
+	plain := bytes.Repeat([]byte{0x45, 0, 0, 0}, 200)
+	block := make([]byte, lz4.CompressBlockBound(len(plain)))
+	n, err := lz4.CompressBlock(plain, block, nil)
+	if err != nil || n == 0 {
+		t.Fatalf("compress: %d %v", n, err)
+	}
+	block = block[:n]
+
+	v2 := append([]byte{compV2Indicator, compV2LZ4}, block...)
+	if got, err := unframeIncoming(framingV2, v2); err != nil || !bytes.Equal(got, plain) {
+		t.Fatalf("lz4-v2: %v", err)
+	}
+
+	swapped := make([]byte, len(block)+1)
+	swapped[0] = lz4CompressByte
+	copy(swapped[1:], block[1:])
+	swapped[len(block)] = block[0]
+	if got, err := unframeIncoming(framingSwap, swapped); err != nil || !bytes.Equal(got, plain) {
+		t.Fatalf("lz4 v1: %v", err)
+	}
+}
+
+func TestPushedCompressIsParsed(t *testing.T) {
+	reply, err := ParsePushReply("PUSH_REPLY,compress lz4-v2,ifconfig 10.8.0.2 255.255.255.0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reply.HasCompress || reply.Compress != "lz4-v2" {
+		t.Fatalf("compress = %v %q", reply.HasCompress, reply.Compress)
+	}
+	reply, err = ParsePushReply("PUSH_REPLY,comp-lzo no,ifconfig 10.8.0.2 255.255.255.0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reply.HasCompLZO || framingFor(reply.CompLZO, reply.Compress) != framingLZO {
+		t.Fatalf("comp-lzo = %v %q", reply.HasCompLZO, reply.CompLZO)
+	}
+}
