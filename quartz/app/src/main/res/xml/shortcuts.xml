<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="selfie"
        android:enabled="true"
        android:icon="@drawable/shortcut_selfie"
        android:shortcutShortLabel="@string/shortcut_selfie">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.quartz.camera"
            android:targetClass="app.quartz.camera.MainActivity">
            <extra android:name="app.quartz.camera.SHORTCUT" android:value="selfie" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="video"
        android:enabled="true"
        android:icon="@drawable/shortcut_video"
        android:shortcutShortLabel="@string/shortcut_video">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.quartz.camera"
            android:targetClass="app.quartz.camera.MainActivity">
            <extra android:name="app.quartz.camera.SHORTCUT" android:value="video" />
        </intent>
    </shortcut>
</shortcuts>
